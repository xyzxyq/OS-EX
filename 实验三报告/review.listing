// wait2 - wait的增强版，返回子进程的时间统计信息
int wait2(int *retime, int *rutime, int *stime) {
    struct proc *p;
    int havekids, pid;

    acquire(&ptable.lock);
    for (;;) {
        havekids = 0;
        for (p = ptable.proc; p < &ptable.proc[NPROC]; p++) {
            if (p->parent != myproc()) continue;
            havekids = 1;

            if (p->state == ZOMBIE) {
                // 收集时间统计信息
                *retime = p->retime;  // 就绪等待时间
                *rutime = p->rutime;  // 实际运行时间
                *stime = p->stime;    // 睡眠时间

                pid = p->pid;
                // 释放进程资源...
                kfree(p->kstack);
                p->kstack = 0;
                freevm(p->pgdir);
                p->state = UNUSED;
                // 清零统计字段...

                release(&ptable.lock);
                return pid;
            }
        }

        if (!havekids || myproc()->killed) {
            release(&ptable.lock);
            return -1;
        }

        sleep(myproc(), &ptable.lock);
    }
}
