<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2024-12-24T03:36:46.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram name="setscheduler流程" id="setscheduler-flow">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="600" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="setscheduler() 调度器切换流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="150" y="20" width="300" height="30" as="geometry"/>
        </mxCell>
        
        <!-- 开始 -->
        <mxCell id="start" value="setscheduler(id)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="60" width="160" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 参数检查 -->
        <mxCell id="check" value="id 有效?&#xa;(0 ≤ id ≤ 4)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="230" y="120" width="140" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 无效返回 -->
        <mxCell id="invalid" value="返回 -1&#xa;(无效ID)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="130" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 获取锁 -->
        <mxCell id="lock" value="acquire(&amp;schedulerlock)&#xa;获取调度器锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="200" width="160" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 清空队列 -->
        <mxCell id="clear" value="clearAllQueues()&#xa;清空所有就绪队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="260" width="160" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 更新调度器 -->
        <mxCell id="update" value="schedSelected = id&#xa;ready_process = schedulerFunction[id]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="320" width="200" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 重建队列 -->
        <mxCell id="rebuild" value="遍历进程表&#xa;将所有RUNNABLE进程&#xa;加入新队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="385" width="160" height="55" as="geometry"/>
        </mxCell>
        
        <!-- 释放锁 -->
        <mxCell id="unlock" value="release(&amp;schedulerlock)&#xa;释放调度器锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="220" y="455" width="160" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 返回成功 -->
        <mxCell id="end" value="返回 0 (成功)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="515" width="160" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 连接线 -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="start" target="check">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a2" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#b85450;fontColor=#b85450;fontSize=10;fontStyle=1;" edge="1" parent="1" source="check" target="invalid">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a3" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;fontColor=#82b366;fontSize=10;fontStyle=1;" edge="1" parent="1" source="check" target="lock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="lock" target="clear">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="clear" target="update">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="update" target="rebuild">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="rebuild" target="unlock">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="unlock" target="end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 右侧说明 -->
        <mxCell id="note1" value="调度器ID：&#xa;0 = DEFAULT&#xa;1 = PRIORITY&#xa;2 = FCFS&#xa;3 = RR&#xa;4 = SML" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=9;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="30" y="120" width="90" height="90" as="geometry"/>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
