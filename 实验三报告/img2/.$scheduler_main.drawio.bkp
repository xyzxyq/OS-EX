<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2024-12-24T03:14:26.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram name="调度器主循环" id="scheduler-main-loop">
    <mxGraphModel dx="1000" dy="700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="800" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="scheduler() 调度器主循环流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="400" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 开始节点 -->
        <mxCell id="start" value="scheduler() 启动" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="70" width="160" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 初始化 -->
        <mxCell id="init" value="初始化&#xa;c = mycpu()&#xa;c->proc = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="140" width="160" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 无限循环开始 -->
        <mxCell id="loop-start" value="for(;;) 无限循环" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="220" width="160" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 步骤1：启用中断 -->
        <mxCell id="step1" value="① sti()&#xa;启用中断" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="280" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step1-note" value="防止死锁：&#xa;无就绪进程时&#xa;允许时钟中断触发" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="275" width="120" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 步骤2：获取锁 -->
        <mxCell id="step2" value="② acquire(&amp;ptable.lock)&#xa;获取进程表锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="350" width="160" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 步骤3：调用调度算法 -->
        <mxCell id="step3" value="③ p = (*ready_process)()&#xa;调用当前调度算法" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="160" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="step3-note" value="函数指针指向：&#xa;priorityScheduler()&#xa;fcfsScheduler()&#xa;rrScheduler()&#xa;smlScheduler()" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="405" width="120" height="80" as="geometry"/>
        </mxCell>
        
        <!-- 判断是否找到进程 -->
        <mxCell id="decision" value="p != 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="340" y="490" width="120" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 是分支：上下文切换 -->
        <mxCell id="yes-branch" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="200" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="yes-label" value="找到就绪进程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#2e7d32;" vertex="1" parent="1">
          <mxGeometry x="110" y="495" width="140" height="20" as="geometry"/>
        </mxCell>
        
        <mxCell id="ctx1" value="c->proc = p&#xa;设置当前运行进程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="520" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ctx2" value="switchuvm(p)&#xa;切换到进程页表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="570" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ctx3" value="p->state = RUNNING&#xa;标记为运行状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="620" width="160" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="ctx4" value="swtch(&amp;c->scheduler, p->context)&#xa;执行上下文切换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="670" width="160" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 进程返回后 -->
        <mxCell id="return-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="80" y="740" width="200" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="return-label" value="进程让出CPU后返回" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;fontColor=#6a1b9a;" vertex="1" parent="1">
          <mxGeometry x="110" y="745" width="140" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="ctx5" value="switchkvm()&#xa;恢复内核页表" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="100" y="770" width="160" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 否分支 -->
        <mxCell id="no-label" value="无就绪进程&#xa;继续循环" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=2;fontColor=#c62828;" vertex="1" parent="1">
          <mxGeometry x="490" y="500" width="100" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 释放锁 -->
        <mxCell id="step-release" value="⑤ release(&amp;ptable.lock)&#xa;释放进程表锁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="860" width="160" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 循环回到开始 -->
        <mxCell id="loop-back" value="回到循环开始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="320" y="930" width="160" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 连接线 -->
        <mxCell id="arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="start" target="init">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="init" target="loop-start">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="loop-start" target="step1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="arrow6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="step3" target="decision">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 是/否分支连接 -->
        <mxCell id="arrow-yes" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#2e7d32;strokeWidth=2;fontColor=#2e7d32;fontSize=12;fontStyle=1;" edge="1" parent="1" source="decision" target="ctx1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="arrow-no" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#c62828;strokeWidth=2;fontColor=#c62828;fontSize=12;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="decision" target="step-release">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="600" y="520"/>
              <mxPoint x="600" y="885"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- 上下文切换内部连接 -->
        <mxCell id="ctx-arrow1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;" edge="1" parent="1" source="ctx1" target="ctx2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-arrow2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;" edge="1" parent="1" source="ctx2" target="ctx3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-arrow3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#82b366;" edge="1" parent="1" source="ctx3" target="ctx4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-arrow4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;" edge="1" parent="1" source="ctx4" target="ctx5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ctx-arrow5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="ctx5" target="step-release">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 循环回连 -->
        <mxCell id="arrow-loop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#666666;" edge="1" parent="1" source="step-release" target="loop-back">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="loop-back-arrow" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;" edge="1" parent="1" source="loop-back" target="loop-start">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="950"/>
              <mxPoint x="700" y="240"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
