<mxfile host="app.diagrams.net" modified="2025-12-06T00:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram name="轮转调度算法" id="rr_scheduler">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="轮转调度算法流程图 (rrScheduler)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#003366;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="400" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 开始 -->
        <mxCell id="start" value="rrScheduler()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="70" width="140" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="start" target="static_var">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 静态变量说明 -->
        <mxCell id="static_var" value="&lt;b&gt;static lastIndex = 0&lt;/b&gt;&lt;br&gt;(静态变量，记录上次调度位置&lt;br&gt;下次调用保留上次的值)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="285" y="140" width="230" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="static_var" target="init_i">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 初始化i -->
        <mxCell id="init_i" value="i = 0&lt;br&gt;(循环计数器)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="335" y="220" width="130" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="init_i" target="loop_check">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 循环条件 -->
        <mxCell id="loop_check" value="i &lt; NPROC ?&lt;br&gt;(是否遍历完所有进程)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="325" y="285" width="150" height="80" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 否 ->返回0 -->
        <mxCell id="a4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="loop_check" target="return_null">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 返回0 -->
        <mxCell id="return_null" value="return 0&lt;br&gt;(无就绪进程)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="300" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 是 -->
        <mxCell id="a5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;" edge="1" parent="1" source="loop_check" target="update_idx">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 更新索引 -->
        <mxCell id="update_idx" value="&lt;b&gt;lastIndex = (lastIndex + 1) % NPROC&lt;/b&gt;&lt;br&gt;(循环递增索引，到达末尾则回到开头)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="280" y="390" width="240" height="55" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="update_idx" target="get_proc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 获取进程 -->
        <mxCell id="get_proc" value="p = &amp;ptable.proc[lastIndex]&lt;br&gt;(获取该位置的进程)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="300" y="465" width="200" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="get_proc" target="check_state">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 判断状态 -->
        <mxCell id="check_state" value="p-&gt;state == RUNNABLE ?&lt;br&gt;(进程是否就绪)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="325" y="540" width="150" height="80" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 是 -> 返回p -->
        <mxCell id="a8" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="check_state" target="return_p">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 返回p -->
        <mxCell id="return_p" value="return p&lt;br&gt;(找到就绪进程)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="555" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 否 -> i++ -->
        <mxCell id="a9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;" edge="1" parent="1" source="check_state" target="inc_i">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- i++ -->
        <mxCell id="inc_i" value="i++&lt;br&gt;(继续查找下一个)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="340" y="650" width="120" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 循环回去 -->
        <mxCell id="loop_back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="inc_i" target="loop_check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="672"/>
              <mxPoint x="200" y="325"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- 说明框 -->
        <mxCell id="note_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="400" width="180" height="130" as="geometry"/>
        </mxCell>
        <mxCell id="note_title" value="&lt;b&gt;算法说明 (Round Robin)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="585" y="405" width="150" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="note_text" value="• 关键：lastIndex是&lt;b&gt;静态变量&lt;/b&gt;&lt;br&gt;• 下次调用从上次位置继续&lt;br&gt;• 取模实现循环遍历&lt;br&gt;• 保证每个进程公平获得&lt;br&gt;  CPU时间片" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="580" y="430" width="160" height="90" as="geometry"/>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
