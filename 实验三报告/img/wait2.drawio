<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3">
  <diagram name="wait2系统调用" id="wait2">
    <mxGraphModel dx="1027" dy="889" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="wait2 系统调用流程图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#003366;" parent="1" vertex="1">
          <mxGeometry x="250" y="20" width="300" height="40" as="geometry" />
        </mxCell>
        <mxCell id="start" value="wait2(retime, rutime, stime)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="300" y="70" width="200" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="1" source="start" target="acquire_lock" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="acquire_lock" value="acquire(&amp;ptable.lock)&lt;br&gt;获取进程表锁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" parent="1" vertex="1">
          <mxGeometry x="320" y="140" width="160" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="1" source="acquire_lock" target="outer_loop" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="outer_loop" value="无限循环开始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="335" y="205" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="1" source="outer_loop" target="init_havekids" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="init_havekids" value="havekids = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="345" y="260" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="1" source="init_havekids" target="inner_loop" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="inner_loop" value="遍历 ptable.proc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" parent="1" vertex="1">
          <mxGeometry x="340" y="315" width="120" height="35" as="geometry" />
        </mxCell>
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="1" source="inner_loop" target="check_parent" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="check_parent" value="p-&gt;parent == myproc() ?&lt;br&gt;(是否是当前进程的子进程)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="300" y="370" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="check_parent" target="continue_inner" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="continue_inner" value="continue&lt;br&gt;下一个进程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" parent="1" vertex="1">
          <mxGeometry x="550" y="395" width="90" height="35" as="geometry" />
        </mxCell>
        <mxCell id="inner_back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=1;strokeColor=#d79b00;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="continue_inner" target="inner_loop" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="620" y="412" />
              <mxPoint x="620" y="332" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;" parent="1" source="check_parent" target="set_havekids" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="set_havekids" value="havekids = 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="345" y="470" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="1" source="set_havekids" target="check_zombie" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="check_zombie" value="p-&gt;state == ZOMBIE ?&lt;br&gt;(子进程是否已退出)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="310" y="525" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="check_zombie" target="continue_inner" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="595" y="560" />
              <mxPoint x="595" y="412" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a10" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;" parent="1" source="check_zombie" target="collect_stats" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="collect_stats" value="&lt;b&gt;收集统计信息 (关键步骤)&lt;/b&gt;&lt;br&gt;*retime = p-&gt;retime&lt;br&gt;*rutime = p-&gt;rutime&lt;br&gt;*stime  = p-&gt;stime" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="295" y="620" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="1" source="collect_stats" target="cleanup" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cleanup" value="pid = p-&gt;pid&lt;br&gt;回收进程资源 (kfree, freevm等)&lt;br&gt;p-&gt;state = UNUSED" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="1" vertex="1">
          <mxGeometry x="295" y="720" width="210" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="1" source="cleanup" target="release_return" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="release_return" value="release(&amp;ptable.lock)&lt;br&gt;return pid" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="325" y="800" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="inner_done_text" value="内层循环结束&lt;br&gt;(所有进程遍历完毕)" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=2;fontColor=#d79b00;align=center;" parent="1" vertex="1">
          <mxGeometry x="100" y="310" width="130" height="40" as="geometry" />
        </mxCell>
        <mxCell id="a13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;exitX=0;exitY=0.5;exitDx=0;exitDy=0;dashed=1;" parent="1" source="inner_loop" target="check_havekids" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="165" y="332" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="check_havekids" value="!havekids ||&lt;br&gt;myproc()-&gt;killed ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="1" vertex="1">
          <mxGeometry x="85" y="400" width="160" height="80" as="geometry" />
        </mxCell>
        <mxCell id="a14" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;" parent="1" source="check_havekids" target="return_fail" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="return_fail" value="release(&amp;ptable.lock)&lt;br&gt;return -1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="90" y="510" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="a15" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="check_havekids" target="sleep_wait" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="65" y="440" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="sleep_wait" value="sleep(myproc(), &amp;ptable.lock)&lt;br&gt;等待子进程状态变化" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="40" y="590" width="195" height="50" as="geometry" />
        </mxCell>
        <mxCell id="outer_back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="sleep_wait" target="outer_loop" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="20" y="615" />
              <mxPoint x="20" y="222" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="note_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="600" y="600" width="200" height="180" as="geometry" />
        </mxCell>
        <mxCell id="note_title" value="&lt;b&gt;wait2 vs wait&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" parent="1" vertex="1">
          <mxGeometry x="660" y="605" width="80" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note_text" value="wait2() 与普通 wait() 的主要区别:&lt;br&gt;&lt;br&gt;在子进程退出时，额外收集&lt;br&gt;三个时间统计字段:&lt;br&gt;• &lt;b&gt;retime&lt;/b&gt;: 就绪时间&lt;br&gt;• &lt;b&gt;rutime&lt;/b&gt;: 运行时间&lt;br&gt;• &lt;b&gt;stime&lt;/b&gt;: 休眠时间&lt;br&gt;&lt;br&gt;这些数据用于分析和比较&lt;br&gt;不同调度算法的性能。" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="610" y="630" width="180" height="145" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
