<mxfile host="app.diagrams.net" modified="2025-12-06T00:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram name="调度器主循环" id="scheduler_main">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="调度器主循环流程图 (scheduler)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#003366;" vertex="1" parent="1">
          <mxGeometry x="220" y="20" width="360" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 开始 -->
        <mxCell id="start" value="scheduler()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="335" y="70" width="130" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="start" target="init">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 初始化 -->
        <mxCell id="init" value="c = mycpu()&lt;br&gt;c-&gt;proc = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="140" width="140" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="init" target="loop_start">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 循环开始标记 -->
        <mxCell id="loop_start" value="无限循环开始" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="335" y="210" width="130" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="loop_start" target="sti">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- sti开中断 -->
        <mxCell id="sti" value="sti()&lt;br&gt;开启中断" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="335" y="270" width="130" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="sti" target="acq1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 获取ptable锁 -->
        <mxCell id="acq1" value="acquire(&amp;ptable.lock)&lt;br&gt;获取进程表锁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="320" y="335" width="160" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="acq1" target="acq2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 获取scheduler锁 -->
        <mxCell id="acq2" value="acquire(&amp;schedulerlock)&lt;br&gt;获取调度器锁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="320" y="400" width="160" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="acq2" target="call_sched">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 调用调度算法 -->
        <mxCell id="call_sched" value="&lt;b&gt;p = (*ready_process)()&lt;/b&gt;&lt;br&gt;调用当前调度算法" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="305" y="465" width="190" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="call_sched" target="rel2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 释放scheduler锁 -->
        <mxCell id="rel2" value="release(&amp;schedulerlock)&lt;br&gt;释放调度器锁" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="320" y="535" width="160" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="rel2" target="check_p">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 判断p是否有效 -->
        <mxCell id="check_p" value="p != 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="600" width="100" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 否 -->
        <mxCell id="a9" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="check_p" target="rel1_no">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 释放锁(无进程) -->
        <mxCell id="rel1_no" value="release(&amp;ptable.lock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="520" y="610" width="150" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 是 -->
        <mxCell id="a10" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;" edge="1" parent="1" source="check_p" target="switch_proc">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 切换进程 -->
        <mxCell id="switch_proc" value="c-&gt;proc = p&lt;br&gt;switchuvm(p)&lt;br&gt;p-&gt;state = RUNNING" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="325" y="690" width="150" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="switch_proc" target="swtch">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 上下文切换 -->
        <mxCell id="swtch" value="&lt;b&gt;swtch(&amp;c-&gt;scheduler, p-&gt;context)&lt;/b&gt;&lt;br&gt;上下文切换到进程p&lt;br&gt;(进程开始执行)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="295" y="770" width="210" height="60" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="swtch" target="return_sched">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 进程返回调度器 -->
        <mxCell id="return_sched" value="switchkvm()&lt;br&gt;c-&gt;proc = 0" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="335" y="850" width="130" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="return_sched" target="rel1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 释放锁 -->
        <mxCell id="rel1" value="release(&amp;ptable.lock)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="325" y="920" width="150" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 循环返回箭头 -->
        <mxCell id="loop_back1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rel1" target="loop_start">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="940"/>
              <mxPoint x="200" y="230"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- 循环返回箭头2 -->
        <mxCell id="loop_back2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="rel1_no" target="loop_start">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="630"/>
              <mxPoint x="700" y="230"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- 循环标注 -->
        <mxCell id="loop_note" value="循环回到开始" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontStyle=2;fontColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="130" y="580" width="90" height="20" as="geometry"/>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
