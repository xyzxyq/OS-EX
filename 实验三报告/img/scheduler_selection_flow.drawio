          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 步骤4: 初始化变量 -->
        <mxCell id="step4" value="初始化全局变量&#xa;ready_process = priorityScheduler&#xa;schedSelected = 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="200" height="60" as="geometry" />
        </mxCell>
        
        <!-- 箭头3-4 -->
