          <mxGeometry x="300" y="80" width="200" height="30" as="geometry" />
        </mxCell>
        
        <!-- 步骤5: scheduler主循环 -->
        <mxCell id="step5" value="scheduler() 主循环&#xa;proc.c:551" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="130" width="200" height="50" as="geometry" />
        </mxCell>
        
        <!-- 步骤6: 调用函数指针 -->
        <mxCell id="step6" value="调用调度函数&#xa;p = (*ready_process)()" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1">
