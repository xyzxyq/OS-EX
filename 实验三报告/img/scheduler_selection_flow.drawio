        </mxCell>
        
        <!-- 步骤D: 重建队列 -->
        <mxCell id="stepD" value="重建就绪队列&#xa;将RUNNABLE进程重新入队" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
