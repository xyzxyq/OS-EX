        </mxCell>
        
        <!-- 步骤A: 用户调用 -->
        <mxCell id="stepA" value="用户程序调用&#xa;setscheduler(4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="130" width="200" height="50" as="geometry" />
        </mxCell>
        
        <!-- 步骤B: 系统调用 -->
        <mxCell id="stepB" value="setscheduler() 系统调用&#xa;proc.c:1021" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
