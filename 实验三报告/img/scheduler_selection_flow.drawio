          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 步骤8: 返回进程 -->
        <mxCell id="step8" value="返回进程 p&#xa;切换上下文执行" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
