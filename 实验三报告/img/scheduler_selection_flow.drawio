          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        
        <!-- 步骤3: 预处理器 -->
        <mxCell id="step3" value="C预处理器检查 sdh.h&#xa;#ifdef PRIORITY → 生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="200" height="50" as="geometry" />
        </mxCell>
        
        <!-- 箭头2-3 -->
