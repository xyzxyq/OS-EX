<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.0.3 Chrome/140.0.7339.249 Electron/38.7.0 Safari/537.36" version="29.0.3">
  <diagram name="测试程序设计" id="scheduler_test">
    <mxGraphModel dx="723" dy="625" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="测试程序设计流程图 (scheduler_test.c)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#003366;" parent="1" vertex="1">
          <mxGeometry x="350" y="10" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="parent_lane" value="" style="swimlane;startSize=30;horizontal=0;fillColor=#dae8fc;strokeColor=#6c8ebf;" parent="1" vertex="1">
          <mxGeometry x="40" y="60" width="700" height="380" as="geometry" />
        </mxCell>
        <mxCell id="parent_title" value="父进程 (测试主程序)" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" parent="parent_lane" vertex="1">
          <mxGeometry x="10" y="5" width="20" height="370" as="geometry" />
        </mxCell>
        <mxCell id="start" value="run_scheduler_test(sched_id)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" parent="parent_lane" vertex="1">
          <mxGeometry x="50" y="20" width="190" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="parent_lane" source="start" target="set_sched" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="set_sched" value="setscheduler(sched_id)&lt;br&gt;设置当前调度算法" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="parent_lane" vertex="1">
          <mxGeometry x="60" y="85" width="170" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="parent_lane" source="set_sched" target="loop_create" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="loop_create" value="for (i = 0; i &lt; 6; i++)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" parent="parent_lane" vertex="1">
          <mxGeometry x="75" y="150" width="140" height="35" as="geometry" />
        </mxCell>
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="parent_lane" source="loop_create" target="fork" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fork" value="pid = fork()&lt;br&gt;创建子进程" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" parent="parent_lane" vertex="1">
          <mxGeometry x="75" y="205" width="140" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="parent_lane" source="fork" target="check_pid" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="check_pid" value="pid == 0 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="parent_lane" vertex="1">
          <mxGeometry x="90" y="270" width="110" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="是 (子进程)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#9673a6;fontStyle=1;dashed=1;" parent="parent_lane" source="check_pid" edge="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="145" y="380" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a6" value="否 (父进程)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="parent_lane" source="check_pid" target="record_pid" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="290" y="300" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="record_pid" value="pids[i] = pid&lt;br&gt;记录子进程ID" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="parent_lane" vertex="1">
          <mxGeometry x="250" y="130" width="120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="loop_back1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" parent="parent_lane" source="record_pid" target="loop_create" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="310" y="167" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a7" value="6个进程创建完毕" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;fontStyle=2;fontSize=10;exitX=0.75;exitY=0;exitDx=0;exitDy=0;" parent="parent_lane" source="loop_create" target="loop_wait" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="180" y="140" />
              <mxPoint x="240" y="140" />
              <mxPoint x="240" y="100" />
              <mxPoint x="420" y="100" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="loop_wait" value="for (i = 0; i &lt; 6; i++)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" parent="parent_lane" vertex="1">
          <mxGeometry x="390" y="150" width="140" height="35" as="geometry" />
        </mxCell>
        <mxCell id="a8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;entryX=0.691;entryY=0.034;entryDx=0;entryDy=0;entryPerimeter=0;" parent="parent_lane" source="loop_wait" target="wait2" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points" />
          </mxGeometry>
        </mxCell>
        <mxCell id="wait2" value="&lt;b&gt;wait2(&amp;retime[i], &amp;rutime[i], &amp;stime[i])&lt;/b&gt;&lt;br&gt;等待子进程并收集统计信息" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" parent="parent_lane" vertex="1">
          <mxGeometry x="315" y="205" width="210" height="50" as="geometry" />
        </mxCell>
        <mxCell id="loop_back2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;" parent="parent_lane" source="wait2" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="550" y="230" />
              <mxPoint x="550" y="180" />
              <mxPoint x="530" y="180" />
            </Array>
            <mxPoint x="530" y="180" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a9" value="6个进程都结束" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;fontStyle=2;fontSize=10;" parent="parent_lane" source="loop_wait" target="print_stats" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="580" y="167" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="print_stats" value="print_statistics(...)&lt;br&gt;输出统计结果" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" parent="parent_lane" vertex="1">
          <mxGeometry x="555" y="200" width="130" height="45" as="geometry" />
        </mxCell>
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="parent_lane" source="print_stats" target="end" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="end" value="结束" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" parent="parent_lane" vertex="1">
          <mxGeometry x="575" y="270" width="90" height="40" as="geometry" />
        </mxCell>
        <mxCell id="child_lane" value="" style="swimlane;startSize=30;horizontal=0;fillColor=#e1d5e7;strokeColor=#9673a6;" parent="1" vertex="1">
          <mxGeometry x="40" y="450" width="700" height="320" as="geometry" />
        </mxCell>
        <mxCell id="child_title" value="子进程逻辑" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=1;fontSize=12;" parent="child_lane" vertex="1">
          <mxGeometry x="10" y="5" width="20" height="310" as="geometry" />
        </mxCell>
        <mxCell id="child_entry" value="(从fork返回0进入)" style="text;html=1;strokeColor=none;fillColor=none;fontStyle=2;fontColor=#9673a6;" parent="child_lane" vertex="1">
          <mxGeometry x="85" y="10" width="120" height="20" as="geometry" />
        </mxCell>
        <mxCell id="check_i" value="i &lt; 3 ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" parent="child_lane" vertex="1">
          <mxGeometry x="100" y="40" width="90" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a11" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;" parent="child_lane" source="check_i" target="cpu_box" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="cpu_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;dashed=1;" parent="child_lane" vertex="1">
          <mxGeometry x="40" y="120" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="cpu_title" value="&lt;b&gt;CPU 密集型进程&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#82b366;align=center;fontColor=#ffffff;rounded=1;" parent="child_lane" vertex="1">
          <mxGeometry x="60" y="125" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="cpu_priority" value="setpriority(getpid(), priority)&lt;br&gt;&lt;b&gt;优先级: 2, 5, 8&lt;/b&gt;&lt;br&gt;(i=0,1,2时)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="child_lane" vertex="1">
          <mxGeometry x="55" y="155" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="cpu_work" value="cpu_intensive(i)&lt;br&gt;大量嵌套循环计算&lt;br&gt;(100 × 100000 次迭代)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" parent="child_lane" vertex="1">
          <mxGeometry x="55" y="220" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a12" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="child_lane" source="check_i" target="io_box" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="io_box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;dashed=1;" parent="child_lane" vertex="1">
          <mxGeometry x="260" y="120" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="io_title" value="&lt;b&gt;IO 密集型进程&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=#d6b656;align=center;fontColor=#ffffff;rounded=1;" parent="child_lane" vertex="1">
          <mxGeometry x="280" y="125" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="io_priority" value="setpriority(getpid(), priority)&lt;br&gt;&lt;b&gt;优先级: 10, 14, 18&lt;/b&gt;&lt;br&gt;(i=3,4,5时)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="child_lane" vertex="1">
          <mxGeometry x="275" y="155" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="io_work" value="io_intensive(i)&lt;br&gt;少量计算 + 频繁sleep(5)&lt;br&gt;(50次循环，每次sleep)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" parent="child_lane" vertex="1">
          <mxGeometry x="275" y="220" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="a13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="child_lane" source="cpu_work" target="child_exit" edge="1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="140" y="310" />
              <mxPoint x="560" y="310" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="a14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" parent="child_lane" source="io_work" target="child_exit" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="child_exit" value="exit()&lt;br&gt;子进程退出" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" parent="child_lane" vertex="1">
          <mxGeometry x="510" y="222.5" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="note_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="780" y="460" width="280" height="300" as="geometry" />
        </mxCell>
        <mxCell id="note_title" value="&lt;b&gt;测试设计说明&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" parent="1" vertex="1">
          <mxGeometry x="870" y="465" width="100" height="20" as="geometry" />
        </mxCell>
        <mxCell id="note_text" value="&lt;b&gt;进程分配：&lt;/b&gt;&lt;br&gt;• 进程0-2: CPU密集型&lt;br&gt;  优先级分别为 2, 5, 8&lt;br&gt;• 进程3-5: IO密集型&lt;br&gt;  优先级分别为 10, 14, 18&lt;br&gt;&lt;br&gt;&lt;b&gt;收集的统计信息：&lt;/b&gt;&lt;br&gt;• retime: 就绪时间&lt;br&gt;• rutime: 运行时间&lt;br&gt;• stime: 休眠时间&lt;br&gt;• turnaround = 三者之和&lt;br&gt;&lt;br&gt;&lt;b&gt;测试流程：&lt;/b&gt;&lt;br&gt;1. 选择调度算法&lt;br&gt;2. 创建6个测试进程&lt;br&gt;3. 等待所有进程完成&lt;br&gt;4. 收集并输出统计结果" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;" parent="1" vertex="1">
          <mxGeometry x="790" y="490" width="260" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
