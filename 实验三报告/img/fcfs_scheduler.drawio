<mxfile host="app.diagrams.net" modified="2025-12-06T00:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram name="FCFS调度算法" id="fcfs_scheduler">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 标题 -->
        <mxCell id="title" value="FCFS调度算法流程图 (fcfsScheduler)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#003366;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="400" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 开始 -->
        <mxCell id="start" value="fcfsScheduler()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="330" y="70" width="140" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="start" target="init1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 初始化firstP -->
        <mxCell id="init1" value="firstP = 0&lt;br&gt;(最早创建的进程指针，初始为空)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="295" y="140" width="210" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="init1" target="init2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 初始化p -->
        <mxCell id="init2" value="p = ptable.proc&lt;br&gt;(从进程表开头开始遍历)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="310" y="210" width="180" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="init2" target="loop_check">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 循环条件判断 -->
        <mxCell id="loop_check" value="p &lt; &amp;ptable.proc[NPROC] ?&lt;br&gt;(是否还有进程未遍历)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="320" y="280" width="160" height="80" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 否 -> 结束 -->
        <mxCell id="a4" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="loop_check" target="return_end">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 返回firstP -->
        <mxCell id="return_end" value="return firstP&lt;br&gt;(返回最早创建的进程)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="295" width="170" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 是 -->
        <mxCell id="a5" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;" edge="1" parent="1" source="loop_check" target="check_runnable">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 判断是否RUNNABLE -->
        <mxCell id="check_runnable" value="p-&gt;state == RUNNABLE ?&lt;br&gt;(进程是否就绪)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="325" y="390" width="150" height="80" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 否 -> 继续 -->
        <mxCell id="a6" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="check_runnable" target="next_p">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="430"/>
              <mxPoint x="560" y="700"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- 箭头: 是 -->
        <mxCell id="a7" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;" edge="1" parent="1" source="check_runnable" target="check_ctime">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 判断创建时间 -->
        <mxCell id="check_ctime" value="firstP == 0 ||&lt;br&gt;p-&gt;ctime &lt; firstP-&gt;ctime ?&lt;br&gt;(当前进程创建更早?)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="295" y="500" width="210" height="100" as="geometry"/>
        </mxCell>
        
        <!-- 箭头: 否 -> 继续 -->
        <mxCell id="a8" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#b85450;fontStyle=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" edge="1" parent="1" source="check_ctime" target="next_p">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="560" y="550"/>
              <mxPoint x="560" y="700"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- 箭头: 是 -->
        <mxCell id="a9" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#82b366;fontStyle=1;" edge="1" parent="1" source="check_ctime" target="update_firstp">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- 更新firstP -->
        <mxCell id="update_firstp" value="&lt;b&gt;firstP = p&lt;/b&gt;&lt;br&gt;(更新为当前进程)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="320" y="630" width="160" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 箭头 -->
        <mxCell id="a10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#003366;" edge="1" parent="1" source="update_firstp" target="next_p">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        
        <!-- p++ -->
        <mxCell id="next_p" value="p++&lt;br&gt;(移动到下一个进程)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="330" y="710" width="140" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 循环回去 -->
        <mxCell id="loop_back" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d79b00;dashed=1;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="next_p" target="loop_check">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="200" y="732"/>
              <mxPoint x="200" y="320"/>
            </Array>
          </mxGeometry>
        </mxCell>
        
        <!-- 说明框 -->
        <mxCell id="note_box" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#666666;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="450" width="180" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="note_title" value="&lt;b&gt;算法说明 (FCFS)&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;" vertex="1" parent="1">
          <mxGeometry x="610" y="455" width="120" height="20" as="geometry"/>
        </mxCell>
        <mxCell id="note_text" value="• ctime是进程创建时间&lt;br&gt;• ctime越小表示越早创建&lt;br&gt;• 先来先服务：&lt;br&gt;  选择最早到达的进程&lt;br&gt;• 无就绪进程则返回0" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="590" y="480" width="160" height="80" as="geometry"/>
        </mxCell>
        
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
